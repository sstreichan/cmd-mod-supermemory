{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@commandcode/harness": ["./types/commandcode-harness.d.ts"]
		}
	},
	"include": ["supermemory.ts", "types/**/*.d.ts"]
}
